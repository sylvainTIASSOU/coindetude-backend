# Copier vers `.env` puis renseigner les vraies valeurs. Ne JAMAIS committer `.env`.

PROJECT_NAME="CoinDétude API"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT=dev
DEBUG=true

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=B59I573BSTg1MzOhRYy7fmGzT4g0PiU6
ACCESS_TOKEN_EXPIRE_MINUTES=15  # 24h
REFRESH_TOKEN_EXPIRE_DAYS=30  # 7 jours
JWT_ALGORITHM="HS256"

BACKEND_CORS_ORIGINS=["*"]

# --- PostgreSQL (doit correspondre au service `db` du docker-compose) --- ?sslmode=require&channel_binding=require
DATABASE_URL=''
POSTGRES_SERVER=''
POSTGRES_PORT=5432
POSTGRES_USER=''
POSTGRES_PASSWORD=''
POSTGRES_DB=''

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""


# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=coindetude

# --- Seed automatique ---
AUTO_SEED_ENABLED=True
AUTO_SEED_LOCK_TTL_SECONDS=300  # 5 min (anti-concurrence multi-worker)


# --- Firebase Cloud Messaging ---
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# --- PayGate Global (T-Money / Flooz) ---
PAYGATE_BASE_URL=https://paygateglobal.com/api/v1
PAYGATE_API_KEY=
PAYGATE_WEBHOOK_SECRET=


# --- Stockage objet (S3/MinIO/R2) ---
S3_ENDPOINT_URL=None  # ex: http://minio:9000 en dev
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="coindetude"
S3_REGION="auto"
S3_PRESIGN_EXPIRE_SECONDS=900  # 15 min

# --- OTP / SMS / WhatsApp ---
OTP_CODE_TTL_SECONDS=300            # 5 min (register/login)
OTP_RESET_TTL_SECONDS=600           # 10 min (reset password)
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_15MIN=3
OTP_MAX_SENDS_PER_DAY=10
OTP_MAX_SENDS_PER_IP_HOUR=20
TRUSTED_DEVICE_TTL_DAYS=30

# Africa's Talking
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID="CoinDetude"
AT_WHATSAPP_SENDER= None  # ex: "22890000000"
OTP_FORCE_CONSOLE= false  # True = code dans la réponse HTTP (dev)

# --- Observabilité --- Literal["DEBUG", "INFO", "WARNING", "ERROR"]
LOG_LEVEL="INFO"
SENTRY_DSN=None

UPLOAD_MAX_SIZE_KB_DOCUMENT=500
UPLOAD_MAX_SIZE_KB_AVATAR=150
UPLOAD_ALLOWED_MIME_TYPES=[ "image/webp", "image/jpeg", "application/pdf" ]
UPLOAD_PRESIGN_TTL_SECONDS=900        # 15 min
UPLOAD_GET_TTL_SECONDS=3600           # 1 h pour la lecture
UPLOAD_PENDING_TTL_HOURS=24           # purge différée
S3_AUTO_CREATE_BUCKET_IN_DEV=true    # crée le bucket au démarrag
