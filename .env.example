# Copier vers `.env` puis renseigner les vraies valeurs. Ne JAMAIS committer `.env`.

ENVIRONMENT=local
DEBUG=true

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL (doit correspondre au service `db` du docker-compose) ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=coindetude
POSTGRES_PASSWORD=coindetude
POSTGRES_DB=coindetude

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=coindetude

# --- Firebase Cloud Messaging ---
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# --- PayGate Global (T-Money / Flooz) ---
PAYGATE_BASE_URL=https://paygateglobal.com/api/v1
PAYGATE_API_KEY=
PAYGATE_WEBHOOK_SECRET=
